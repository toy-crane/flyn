# 모바일 앱은 이 파일에 선언한 모든 값을 필요로 합니다.
# EXPO_PUBLIC_ 값은 앱 번들에서 공개되므로 비밀값을 넣지 마세요.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hono API의 기준 주소. Simulator와 Emulator에서 실제로 닿는 주소여야 합니다.
# Android Emulator는 호스트의 localhost에 닿지 않으므로 LAN 주소를 사용하세요.
EXPO_PUBLIC_API_URL=

# 두 Google client ID는 공개 값입니다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 설정의 이용약관과 개인정보 처리방침이 여는 웹의 기준 주소입니다.
# apps/web이 /terms와 /privacy를 소유합니다. 로컬에서는 웹 개발 서버 주소를 씁니다.
EXPO_PUBLIC_WEB_URL=

# 설정의 문의하기가 메일 앱에 채워 넣는 받는 사람 주소입니다.
EXPO_PUBLIC_SUPPORT_EMAIL=
