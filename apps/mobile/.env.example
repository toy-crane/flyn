# EXPO_PUBLIC_* 값은 앱 번들에 그대로 노출된다. 공개 가능한 값만 둘 것.
# 로컬 시뮬레이터는 API_BASE_URL 기본값(http://localhost:3000)으로 동작하므로 생략 가능.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Supabase 로컬 스택 값 — `supabase status`에서 복사. publishable 키는 클라이언트 안전.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google OAuth 클라이언트 ID — 공개값. Google Cloud 콘솔 > 사용자 인증 정보에서 복사.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
