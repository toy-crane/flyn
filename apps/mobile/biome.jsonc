{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    // `bun run celebration:lottie`가 만드는 Lottie 파일이다. Biome의 키 정렬이
    // 도형의 `ty`를 뒤로 보내면 lottie-android가 도형을 빈 채로 읽으므로 손대지
    // 않는다. 내용은 scripts의 check가 생성기와 견준다.
    "includes": ["**", "!src/features/episode/ui/celebration/*.json"]
  }
}
