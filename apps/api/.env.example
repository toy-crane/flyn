# 이 파일은 설정 이름과 공통 모델을 보여줍니다. 실제 값은 apps/api/.env.local에 두고 Git에 넣지 않습니다.
# Vercel의 Development, Preview와 Production 값은 API 프로젝트에서 따로 설정합니다.

# 로컬에서 쓰는 Vercel AI Gateway 자격 증명입니다. 서버만 읽습니다.
# Vercel 배포에서는 자동 제공되는 OIDC 인증을 쓰므로 이 키를 설정하지 않습니다.
AI_GATEWAY_API_KEY=
# 모든 AI 기능에서 쓰는 공통 모델. 로컬 개발과 배포 환경에 같은 값을 설정합니다.
AI_GATEWAY_MODEL=openai/gpt-5.6-luna

# 모바일 앱과 같은 Supabase 프로젝트의 주소.
SUPABASE_URL=
# 같은 프로젝트의 JWKS 주소. access token 검증에 사용합니다.
# 로컬 스택: http://127.0.0.1:54331/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# 공개 값입니다. auth: "user"가 검증을 마친 뒤 사용자 권한 클라이언트를 만들 때
# 이 키를 씁니다. secret key는 이 경로에 필요하지 않으므로 두지 않습니다.
SUPABASE_PUBLISHABLE_KEY=
