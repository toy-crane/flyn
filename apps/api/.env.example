# Supabase 로컬 스택 값 — `supabase status` 출력에서 복사한다(.env.local로).
# URL·publishable 키는 공개 가능하지만 SECRET 키는 절대 커밋 금지·EXPO_PUBLIC_* 금지.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# JWT 검증용 JWKS. 로컬은 URL로 충분(인라인 SUPABASE_JWKS도 가능).
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Apple 계정 삭제용 — 넷이 모두 있어야 동작한다. 하나라도 없으면 Apple 로그인
# 사용자의 계정 삭제가 중단된다(취소 수단 없이 지우지 않는다).
# Apple Developer > Certificates, Identifiers & Profiles > Keys에서 Sign in with
# Apple 키를 만들고 받은 .p8로 채운다. **.p8과 이 값들은 절대 커밋 금지.**
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=FGHIJ67890
# 번들 ID. supabase/config.toml의 [auth.external.apple].client_id와 같아야 한다.
APPLE_CLIENT_ID=com.odd.flyn
# .p8 파일 내용. 한 줄로 넣을 때는 개행을 \n으로 이스케이프한다.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
