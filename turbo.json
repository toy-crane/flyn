{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,js,jsx,json,jsonc,css,md}", "biome.jsonc"]
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#test:scripts": {
      "inputs": ["scripts/**/*.ts", "apps/mobile/metro.config.js"],
      "outputs": []
    },
    "//#typecheck:scripts": {
      "inputs": ["scripts/**/*.ts", "tsconfig.scripts.json"],
      "outputs": []
    },
    "//#dev:setup": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "dependsOn": ["//#dev:setup"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["//#test:scripts"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["//#typecheck:scripts"],
      "outputs": []
    }
  }
}
