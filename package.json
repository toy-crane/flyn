{
  "name": "flyn",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint test typecheck",
    "db:start": "supabase start",
    "db:diff": "supabase db diff -f",
    "db:types": "bun run --filter @flyn/supabase gen",
    "db:reset": "supabase db reset && bun run db:types",
    "db:test": "supabase test db",
    "auth:session": "bun run scripts/auth-session.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "supabase": "^2.109.1",
    "turbo": "^2.10.6",
    "typescript": "~6.0.3",
    "ultracite": "^7.9.4"
  }
}
