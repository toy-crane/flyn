{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/jest"
  ],
  "files": {
    "includes": [
      // .claude/settings.json은 Claude Code가 런타임에 다시 쓴다 — 린트를
      // 걸어두면 도구가 파일을 건드릴 때마다 `bun run check`가 깨진다.
      // .claude는 반드시 루트 기준으로 앵커한다. `**/.claude`로 쓰면 이
      // 저장소가 워크트리(.../.claude/worktrees/...)로 체크아웃됐을 때 상위
      // 경로가 걸려 전체 파일이 조용히 린트에서 빠진다.
      // supabase gen types 산출물 — 사람이 쓰는 파일이 아니라 재생성되면 덮어써진다.
      // 글롭이 아니라 정확한 경로로 앵커한다(같은 이름의 다른 파일까지 빠지지 않도록).
      "!!packages/supabase/src/database.types.ts",
      // HTML이 아니라 Go 템플릿이다({{ .Token }}). 파서가 파싱 에러를 내고,
      // 포매터가 변수를 줄바꿈해 넣으면 발송되는 메일 본문이 그대로 바뀐다.
      "!!supabase/templates",
      "!!.claude",
      // 벤더에서 설치한 스킬(skills-lock.json이 관리한다). 우리가 쓴 코드가 아니고
      // 업데이트하면 통째로 덮어써지므로 지적을 반영할 방법이 없다 —
      // templates/shell.html 하나가 38건을 내며 `bun run lint`를 계속 깨뜨렸다.
      // .claude와 같은 이유로 루트 기준 앵커다(워크트리에서 상위 경로가 걸린다).
      "!!.agents"
    ]
  },
  "overrides": [
    {
      // Expo·Jest 설정 파일은 CommonJS다. __dirname을 import.meta.dirname으로
      // 고치면 Node가 ESM으로 파싱해 Metro가 아예 뜨지 않는다.
      "includes": ["**/metro.config.js", "**/jest.config.js"],
      "linter": {
        "rules": {
          "correctness": { "noGlobalDirnameFilename": "off" }
        }
      }
    },
    {
      // jest는 전역 API를 쓴다(apps/api는 bun:test를 import하므로 해당 없음).
      // .ts와 .tsx를 모두 적는다 — 화면이 아닌 순수 로직 테스트는 JSX가 없어
      // .test.ts로 저장되고, .tsx만 적으면 그쪽 전역이 통째로 미선언이 된다.
      "includes": [
        "apps/mobile/**/*.test.ts",
        "apps/mobile/**/*.test.tsx",
        // 테스트에서만 쓰는 공용 대역. 여기서도 jest.fn·jest.requireActual을 쓴다.
        "apps/mobile/src/test-support/**",
        "apps/mobile/jest-setup.js"
      ],
      "javascript": {
        "globals": [
          "afterAll",
          "afterEach",
          "beforeAll",
          "beforeEach",
          "describe",
          "expect",
          "it",
          "jest",
          "test"
        ]
      }
    }
  ]
}
