{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  // Expo가 만들어 두는 네이티브 폴더를 스캐너가 들어가지 않게 한다. CocoaPods가
  // `ios/Pods` 안에 심는 심볼릭 링크를 따라 들어가면 Biome 2.5가 스택을 넘겨
  // 죽고, 그 죽음이 종료 코드 0으로 도착해 검사가 통과한 것처럼 보인다.
  // `.gitignore`는 검사할 파일만 거르고 스캐너의 탐색은 막지 못한다.
  //
  // 같은 일을 하는 `files.includes`의 `!!`를 쓰지 않는다. 배열은 `extends`에서
  // 합쳐지지 않고 대체되어서, ultracite가 그 자리에 담아 둔 서른 남짓한 제외가
  // 통째로 사라진다. 이 키는 문서가 `!!`를 권하며 deprecated로 적어 두었지만,
  // 배열을 건드리지 않고 두 폴더만 뺄 수 있는 자리가 여기뿐이다. Biome이 이 키를
  // 지우면 그때 ultracite의 목록을 함께 적는 쪽으로 옮긴다.
  "files": {
    "experimentalScannerIgnores": ["ios", "android"]
  },
  "overrides": [
    {
      // Biome parses only the frontmatter of an .astro file, so anything the
      // template alone uses reads as dead code. `astro check` runs these two
      // checks with the template included, so turning them off here loses no
      // coverage.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
